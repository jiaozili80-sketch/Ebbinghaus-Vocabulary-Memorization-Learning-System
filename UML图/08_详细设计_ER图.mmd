    sys_user {
        bigint id PK
        varchar username
        varchar password
        varchar nickname
        varchar role
        tinyint status
    }
    
    word_book {
        bigint id PK
        varchar name
        varchar category
        varchar type
        int word_count
    }
    
    word {
        bigint id PK
        bigint book_id FK
        varchar word
        text meaning
        varchar phonetic
        text example
    }
    
    study_plan {
        bigint id PK
        bigint user_id FK
        bigint book_id FK
        int plan_word_count
        int review_multiplier
    }
    
    study_record {
        bigint id PK
        bigint user_id FK
        bigint word_id FK
        varchar result
        int mastery_level
        datetime study_time
    }
    
    review_schedule {
        bigint id PK
        bigint user_id FK
        bigint word_id FK
        int round
        datetime next_review_time
        varchar status
    }
    
    wrong_word {
        bigint id PK
        bigint user_id FK
        bigint word_id FK
        int wrong_count
        datetime last_wrong_time
    }
